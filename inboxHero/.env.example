# Only used for embeddings/retrieval (plan.md 3c).
GEMINI_API_KEY=your-api-key-here
EMBEDDING_MODEL=gemini-embedding-001

# Used for every other LLM call (both agents, citation_checker Layer B) --
# a local Ollama model, no API key needed. Requires `ollama pull gemma4:12b`
# and the Ollama server running locally.
OLLAMA_MODEL=gemma4:12b
# OLLAMA_API_BASE=http://localhost:11434   # uncomment if not the default
